<%- include('../partials/header') %>

<div class="hero">
    <h1>Fresh from Farm to your Table</h1>
    <p>Buy high-quality, organic agricultural products directly from farmers.</p>
    
    <div style="margin-top: 2rem; max-width: 600px; margin-left: auto; margin-right: auto;">
        <form action="/" method="GET" style="display: flex; gap: 1rem;">
            <input type="text" name="search" class="form-control" placeholder="Search for crops, vegetables, fruits..." style="border-radius: 50px; padding: 1rem 1.5rem;">
            <button type="submit" class="btn btn-primary" style="border-radius: 50px;">Search</button>
        </form>
    </div>
</div>

<div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
    <h2>Latest Fresh Produce</h2>
    
    <form action="/" method="GET" style="display: flex; gap: 1rem; align-items: center;">
        <% if (locals.user && user.role === 'buyer') { %>
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; color: var(--primary); font-weight: 600;">
                <input type="checkbox" name="nearMe" value="true" onchange="this.form.submit()" <%= locals.query && query.nearMe === 'true' ? 'checked' : '' %>>
                📍 Near Me
            </label>
        <% } %>
        <select name="type" class="form-control" onchange="this.form.submit()" style="width: auto;">
            <option value="">All Categories</option>
            <option value="Vegetable" <%= locals.query && query.type === 'Vegetable' ? 'selected' : '' %>>Vegetables</option>
            <option value="Fruit" <%= locals.query && query.type === 'Fruit' ? 'selected' : '' %>>Fruits</option>
            <option value="Grain" <%= locals.query && query.type === 'Grain' ? 'selected' : '' %>>Grains</option>
        </select>
    </form>
</div>

<div class="product-grid">
    <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
            <div class="product-card">
                <img src="<%= product.imageUrl || 'https://images.unsplash.com/photo-1542838132-92c53300491e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80' %>" alt="<%= product.name %>" class="product-img">
                <div class="product-info">
                    <div style="display: flex; justify-content: space-between; align-items: start;">
                        <h3 class="product-title"><%= product.name %></h3>
                        <span class="badge <%= product.status === 'Available' ? 'badge-available' : 'badge-sold' %>"><%= product.status %></span>
                    </div>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">
                        📍 <%= product.location %>
                        <% if (product.distanceKm !== undefined) { %>
                            <span style="color: var(--primary); font-weight: 600; margin-left: 0.5rem;">(<%= product.distanceKm %> km away)</span>
                        <% } %>
                    </p>
                    <p>👨‍🌾 Farmer: <%= product.farmer.name %></p>
                    <p>📦 Quantity: <%= product.quantity %></p>
                    
                    <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;">
                        <div class="product-price">₹<%= product.price %></div>
                        <a href="/product/<%= product._id %>" class="btn btn-primary">View</a>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div style="grid-column: 1 / -1; text-align: center; padding: 4rem;">
            <h3>No products found under this search/category.</h3>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
