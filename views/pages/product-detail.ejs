<%- include('../partials/header') %>

<div style="background: white; border-radius: 16px; padding: 2rem; box-shadow: var(--shadow); display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;">
    <div>
        <img src="<%= product.imageUrl || 'https://images.unsplash.com/photo-1542838132-92c53300491e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80' %>" alt="<%= product.name %>" style="width: 100%; height: auto; border-radius: 12px; object-fit: cover;">
    </div>
    
    <div style="display: flex; flex-direction: column;">
        <div style="display: flex; justify-content: space-between; align-items: start;">
            <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem;"><%= product.name %></h1>
            <span class="badge <%= product.status === 'Available' ? 'badge-available' : 'badge-sold' %>" style="font-size: 1rem;"><%= product.status %></span>
        </div>
        
        <p style="color: var(--primary); font-size: 2rem; font-weight: 800; margin-bottom: 2rem;">₹<%= product.price %></p>
        
        <div style="background: var(--bg); padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem;">
            <h3 style="margin-bottom: 1rem; border-bottom: 1px solid #ccc; padding-bottom: 0.5rem;">Product Details</h3>
            <p style="margin-bottom: 0.5rem;"><strong>Type:</strong> <%= product.type %></p>
            <p style="margin-bottom: 0.5rem;"><strong>Location:</strong> <%= product.location %></p>
            <p style="margin-bottom: 0.5rem;"><strong>Quantity Available:</strong> <%= product.quantity %></p>
            <p style="margin-bottom: 0.5rem;"><strong>Listed On:</strong> <%= new Date(product.createdAt).toLocaleDateString() %></p>
        </div>

        <div style="background: #e3f2fd; padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem;">
            <h3 style="margin-bottom: 1rem; color: #1565c0;">👨‍🌾 Farmer Information</h3>
            <p style="margin-bottom: 0.5rem;"><strong>Name:</strong> <%= product.farmer.name %></p>
            <p style="margin-bottom: 0.5rem;"><strong>Email:</strong> <%= product.farmer.email %></p>
            <a href="mailto:<%= product.farmer.email %>" class="btn btn-secondary" style="margin-top: 1rem;">Contact Farmer</a>
        </div>

        <div style="margin-top: auto;">
            <% if (user && user.role === 'buyer') { %>
                <% if (product.status === 'Available') { %>
                    <form action="/cart/add/<%= product._id %>" method="POST">
                        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1.2rem;">Add to Cart 🛒</button>
                    </form>
                <% } else { %>
                    <button class="btn" style="width: 100%; padding: 1rem; font-size: 1.2rem; background: #e2e8f0; color: #718096; cursor: not-allowed;" disabled>Out of Stock</button>
                <% } %>
            <% } else if (!user) { %>
                <a href="/auth/signin" class="btn btn-primary" style="width: 100%; text-align: center; padding: 1rem; font-size: 1.2rem;">Sign In to Buy</a>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
