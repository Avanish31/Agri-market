<%- include('../partials/header') %>

<div class="container" style="margin-top: 2rem;">
    <div style="background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);">
        <h2 style="margin-bottom: 1rem; color: #1f2937; display: flex; align-items: center; gap: 0.5rem;">
            📊 Market Analysis
        </h2>
        <p style="color: #4b5563; margin-bottom: 2rem; font-size: 1.1rem; line-height: 1.5;">
            Discover which products are currently in high demand across the platform. 
            Use these search frequency insights to price your products competitively and maximize your sales.
        </p>
        
        <div style="overflow-x: auto; border: 1px solid #e5e7eb; border-radius: 8px;">
            <table style="width: 100%; border-collapse: collapse; min-width: 800px; text-align: left;">
                <thead>
                    <tr style="background-color: #f9fafb; border-bottom: 2px solid #e5e7eb;">
                        <th style="padding: 1rem 1.5rem; font-weight: 600; color: #374151;">Product Name</th>
                        <th style="padding: 1rem 1.5rem; font-weight: 600; color: #374151;">Category</th>
                        <th style="padding: 1rem 1.5rem; font-weight: 600; color: #374151;">Avg. Market Price</th>
                        <th style="padding: 1rem 1.5rem; font-weight: 600; color: #374151;">Demand (Search Freq)</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products && products.length > 0) { %>
                        <% products.forEach((p, index) => { %>
                            <tr style="border-bottom: 1px solid #e5e7eb; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#f3f4f6'" onmouseout="this.style.backgroundColor='transparent'">
                                <td style="padding: 1rem 1.5rem; font-weight: 500; color: #111827;">
                                    <%= p.name %>
                                </td>
                                <td style="padding: 1rem 1.5rem; color: #6b7280; text-transform: capitalize;">
                                    <%= p.type || 'N/A' %>
                                </td>
                                <td style="padding: 1rem 1.5rem; color: #111827; font-weight: 500;">
                                    ₹<%= p.price %> <span style="font-size: 0.875rem; color: #9ca3af; font-weight: normal;">/ <%= p.quantity %></span>
                                </td>
                                <td style="padding: 1rem 1.5rem;">
                                    <% if (p.searchCount && p.searchCount > 0) { %>
                                        <div style="display: inline-flex; align-items: center; background: #ecfdf5; color: #059669; padding: 0.25rem 0.75rem; border-radius: 9999px; font-weight: 600; font-size: 0.875rem;">
                                            🔥 <%= p.searchCount %> searches
                                        </div>
                                    <% } else { %>
                                        <span style="color: #9ca3af; font-size: 0.875rem;">No recent searches</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="padding: 2rem; text-align: center; color: #6b7280;">
                                No market data available right now.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
