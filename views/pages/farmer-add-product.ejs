<%- include('../partials/header') %>

<div class="form-container" style="max-width: 600px;">
    <h2>Add New Produce</h2>
    <p style="color: var(--text-muted); margin-bottom: 2rem;">List your agricultural products to buyers directly.</p>

    <form action="/farmer/add" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label for="name">Crop Name</label>
            <input type="text" id="name" name="name" class="form-control" required placeholder="e.g., Organic Tomatoes">
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
                <label for="type">Crop Type</label>
                <select id="type" name="type" class="form-control" required>
                    <option value="Vegetable">Vegetable</option>
                    <option value="Fruit">Fruit</option>
                    <option value="Grain">Grain</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="form-group">
                <label for="price">Price (₹)</label>
                <input type="number" id="price" name="price" class="form-control" required placeholder="0.00" min="0" step="0.01">
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group">
                <label for="quantity">Quantity Available</label>
                <input type="text" id="quantity" name="quantity" class="form-control" required placeholder="e.g., 50 kg">
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" class="form-control" required placeholder="e.g., Pune, Maharashtra">
            </div>
        </div>

        <div class="form-group">
            <label for="image">Product Image</label>
            <input type="file" id="image" name="image" class="form-control" accept="image/*" onchange="previewImage(event)">
            <div style="margin-top: 1rem;">
                <img id="imagePreview" src="#" alt="Preview" style="display: none; max-width: 100%; height: 200px; object-fit: cover; border-radius: 8px;">
            </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1.1rem; margin-top: 1rem;">List Product to Market</button>
    </form>
</div>

<script>
function previewImage(event) {
    const reader = new FileReader();
    reader.onload = function(){
        const output = document.getElementById('imagePreview');
        output.src = reader.result;
        output.style.display = 'block';
    };
    reader.readAsDataURL(event.target.files[0]);
}
</script>

<%- include('../partials/footer') %>
