<%- include('../partials/header') %>

<div class="form-container">
    <h2 style="text-align: center; margin-bottom: 2rem;">Create an Account 🌱</h2>
    
    <% if (error) { %>
        <div class="error-msg"><%= error %></div>
    <% } %>

    <form action="/auth/signup" method="POST">
        <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" class="form-control" required placeholder="John Doe">
        </div>

        <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" class="form-control" required placeholder="john@example.com">
        </div>
        
        <div class="form-group">
            <label for="address">City or Address</label>
            <input type="text" id="address" name="address" class="form-control" placeholder="E.g., Mumbai, Maharashtra">
            <small style="color: var(--text-muted); font-size: 0.8rem; display: block; margin-top: 0.25rem;">Used to find products or farmers near you.</small>
        </div>
        
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" class="form-control" required>
        </div>

        <div class="form-group">
            <label for="role">I want to...</label>
            <select id="role" name="role" class="form-control" required>
                <option value="buyer">Buy agricultural products</option>
                <option value="farmer">Sell my produce (Farmer)</option>
            </select>
        </div>
        
        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem; padding: 1rem; font-size: 1.1rem;">Sign Up</button>
    </form>
    
    <p style="text-align: center; margin-top: 2rem; color: var(--text-muted);">
        Already have an account? <a href="/auth/signin" style="color: var(--primary); font-weight: 600;">Sign in</a>
    </p>
</div>

<%- include('../partials/footer') %>
